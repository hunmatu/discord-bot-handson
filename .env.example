# Discord Bot のトークン
# Discord Developer Portal から取得してください
# https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# クライアントID (Application ID)
# Discord Developer Portal のアプリケーションページに記載されています
CLIENT_ID=your_client_id_here

# サーバーID (Guild ID)
# Discordでサーバーを右クリック > IDをコピー で取得できます
# ※開発者モードを有効にする必要があります
GUILD_ID=your_guild_id_here

# Webhook設定
# Webhookサーバーのポート番号
WEBHOOK_PORT=3000

# Webhookからメッセージを送信するデフォルトのチャンネルID
# チャンネルを右クリック > IDをコピー で取得できます
# ※開発者モードを有効にする必要があります
WEBHOOK_CHANNEL_ID=your_channel_id_here
